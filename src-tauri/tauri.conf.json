{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Term Lab",
  "version": "0.2.0",
  "identifier": "me.matheusmonteiro.termlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Term Lab",
        "width": 1100,
        "height": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQjlENTU1NEVDMUJFNjgKUldSb3ZzRk9WZFc1TXovSVowWTNkQkM3OG5GaGE5bWxjcFhvc2V5RHlHT3ZXZlV3ek1FVVlNaHIK",
      "endpoints": [
        "https://github.com/matheusmntt/term-lab/releases/latest/download/latest.json"
      ]
    }
  }
}
